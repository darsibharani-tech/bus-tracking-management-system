    </tr>
    <tr>
        <td><code>Stop</code></td>
        <td><code>GeoLocation</code></td>
        <td>Composition (has-a)</td>
        <td>Each stop has dedicated coordinate values.</td>
    </tr>
    <tr>
        <td><code>Bus</code></td>
        <td><code>GeoLocation</code></td>
        <td>Composition (has-a)</td>
        <td>Each bus encapsulates its live telemetry coordinates.</td>
    </tr>
    <tr>
        <td><code>BusDepotApplication</code></td>
        <td><code>Bus</code></td>
        <td>Aggregation</td>
        <td>Depot manages buses, but buses exist independently.</td>
    </tr>
    <tr>
        <td><code>BusDepotApplication</code></td>
        <td><code>RouteAssignment</code></td>
        <td>Association / Composition</td>
        <td>Central system creates and manages schedule allocations.</td>
    </tr>
</table>

