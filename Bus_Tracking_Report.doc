        <td><code>Stop</code></td>
        <td>Represents physical passenger stops along routes.</td>
        <td><code>private: stopId, stopName, location, distanceFromStartKm</code></td>
        <td><code>getStopName()</code>, <code>getLocation()</code>, <code>getDistance()</code></td>
    </tr>
