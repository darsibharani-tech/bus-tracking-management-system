    </tr>
    <tr>
        <td><code>std::vector&lt;Stop&gt;</code></td>
        <td>Inside <code>Route</code></td>
        <td>Preserves strictly ordered sequence of checkpoints.</td>
        <td>Access: <i>O(1)</i>, Append: <i>O(1)</i></td>
    </tr>
    <tr>
        <td><code>std::vector&lt;RouteAssignment&gt;</code></td>
        <td>Daily Schedules</td>
